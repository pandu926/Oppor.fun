{
  "name": "oppor-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "test": "playwright test",
    "test:unit": "tsx --test tests/unit.test.ts",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json README.md",
    "format:check": "prettier --check src tests scripts/*.mjs *.ts *.json README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "viem": "2.57.4",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "ws": "^8.21.0",
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0"
  }
}
