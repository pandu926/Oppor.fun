# demo provides clearly identified sample campaigns; live connects to the real backend.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/v1
VITE_SITE_URL=https://oppor.fun
# Must match the backend deployment. Arc Testnet is 5042002; local fixtures use 5042.
VITE_CHAIN_ID=5042002
VITE_RPC_URL=https://rpc.testnet.arc.io
VITE_EXPLORER_URL=https://explorer.testnet.arc.io
# Optional server-only build input for live public campaign pre-rendering.
# PRERENDER_API_URL=https://api.example.com/v1
# Required for live escrow creation; must match the audited deployment and backend.
VITE_FACTORY_ADDRESS=
# The ERC-20 USDC interface is 6 decimals; native gas USDC is 18 decimals.
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
